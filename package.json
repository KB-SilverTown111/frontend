{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "commit": "node scripts/commit.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "preview": "vite preview",
    "test:onboarding": "node scripts/run-tests.mjs onboarding-",
    "test:screen-data": "node --test scripts/screen-data.test.mjs",
    "test:app-loading": "node --test scripts/app-loading.test.mjs",
    "test:auto-login": "node --test scripts/auto-login.test.mjs",
    "test:transfer": "node --test scripts/transfer-home.test.mjs",
    "test:service-routes": "node --test scripts/service-routes.test.mjs",
    "test:service-api": "node --test scripts/service-api.test.mjs",
    "test:service-stores": "node --test scripts/service-stores.test.mjs",
    "test:camera": "node --test scripts/camera.test.mjs",
    "test:design-system": "node --test scripts/design-system.test.mjs",
    "test:font-scale": "node --test scripts/font-scale.test.mjs",
    "test:my-page": "node --test scripts/my-page.test.mjs",
    "test:navigation": "node --test scripts/navigation.test.mjs"
  },
  "lint-staged": {
    "src/**/*.{js,vue}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor-community/contacts": "^8.0.0",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8.5.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/geolocation": "^8.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "pinia": "^4.0.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5"
  },
  "engines": {
    "node": "^22.22.1 || >=24.12.0"
  }
}
